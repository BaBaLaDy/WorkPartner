# WorkPartner Agent — Environment Variables
# Copy this file to .env and fill in your API keys.
# The .env file is gitignored and will never be committed.

# LLM provider (DashScope / OpenAI-compatible)
DASHSCOPE_API_KEY=sk-your-key-here

# Vision model for desktop coordinate reading (Ark / ByteDance)
ARK_API_KEY=your-key-here

# Telegram bot (IM Bridge)
TELEGRAM_BOT_TOKEN=your-bot-token-here

# Feishu / Lark (IM Bridge)
FEISHU_APP_ID=your-app-id-here
FEISHU_APP_SECRET=your-app-secret-here
# im_notify targets — your own open_id / a group chat_id
FEISHU_MY_OPEN_ID=your-open-id-here
FEISHU_MY_TEAM_ID=your-group-chat-id-here
# Webhook mode only (strongly recommended when the webhook is publicly reachable)
FEISHU_VERIFY_TOKEN=your-verify-token-here
FEISHU_ENCRYPT_KEY=your-encrypt-key-here
